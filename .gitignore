# API keys — never commit these
.env

# Runtime cache, regenerated automatically, no need to commit
# (data/experience_log.json is NOT listed here on purpose — it holds
# persistent agentic-run demo records used for PA3 presentation/demo
# purposes, and is meant to stay available locally across sessions.)
data/news_cache.json
# Rewritten on every agentic run
data/llm_prompt_log.txt

# Reference papers stay on the local machine (publisher copyright).
# The reading list with links is in docs/research/README_RESEARCH.md
docs/research/*.pdf
docs/research/*.htm

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Virtual env (if accidentally placed inside the project)
venv/
env/
.venv/

# Distribution
*.egg-info/
dist/
build/

# Copy this file to .env and put your own keys in it.
# .env is in .gitignore; this template has no real keys.

# DeepSeek key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# news for Market Intelligence (optional, without it you get the demo feed)
# Marketaux free plan: https://www.marketaux.com/ (100 requests a day)
NEWS_API_PROVIDER=marketaux
MARKETAUX_API_KEY=your_marketaux_key_here
NEWS_REFRESH_MINUTES=15

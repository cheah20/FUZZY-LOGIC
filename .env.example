# ASTDSS Terminal — Environment Variables TEMPLATE
# Copy this file to .env and fill in your real keys.
# .env is gitignored and will NOT be committed to GitHub.
# This .env.example file IS safe to commit — it contains no real keys.

# DeepSeek API Key — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Market Intelligence news provider (optional)
# Without these, Market Intelligence falls back to the demo sample feed.
# Marketaux free tier: https://www.marketaux.com/ (100 requests/day)
NEWS_API_PROVIDER=marketaux
MARKETAUX_API_KEY=your_marketaux_key_here
NEWS_REFRESH_MINUTES=15
